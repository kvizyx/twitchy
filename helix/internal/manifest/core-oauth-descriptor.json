{
  "schema": 1,
  "module": "github.com/kvizyx/twitchy",
  "core": {
    "interfaces": {
      "Clock": [
        "Now() time.Time",
        "NewTimer(time.Duration) Timer"
      ],
      "Timer": [
        "C() <-chan time.Time",
        "Stop() bool"
      ],
      "TokenSource": [
        "Token(context.Context) (CredentialSnapshot, error)"
      ],
      "RefreshableTokenSource": [
        "Token(context.Context) (CredentialSnapshot, error)",
        "Refresh(context.Context, CredentialSnapshot, RefreshReason) (CredentialSnapshot, error)"
      ]
    },
    "enums": {
      "TokenClass": {
        "type": "string",
        "values": {
          "TokenClassApp": "app",
          "TokenClassUser": "user",
          "TokenClassExtension": "extension"
        }
      },
      "RefreshReason": {
        "type": "string",
        "values": {
          "RefreshReasonExpired": "expired",
          "RefreshReasonUnauthorized": "unauthorized"
        }
      }
    },
    "structs": {
      "Credential": {
        "fields": [
          "AccessToken string",
          "ClientID string",
          "TokenClass TokenClass",
          "UserID string",
          "Scopes []AuthorizationScope",
          "ExpiresAt time.Time",
          "Refreshable bool",
          "Generation uint64"
        ]
      },
      "RateLimitPolicy": {
        "fields": [
          "Wait bool",
          "MaxWait time.Duration"
        ]
      }
    },
    "functions": [
      "New(...Option) (*Client,error)",
      "WithHTTPClient(*http.Client) Option",
      "WithBaseURL(string) Option",
      "WithUserAgent(string) Option",
      "WithTokenSource(TokenSource) Option",
      "WithStaticToken(Credential) Option",
      "WithRateLimitPolicy(RateLimitPolicy) Option",
      "WithPageLimit(int) PagerOption"
    ],
    "sentinels": [
      "ErrInvalidOption",
      "ErrConflictingOptions",
      "ErrInvalidClient",
      "ErrNotRefreshable",
      "ErrCursorCycle",
      "ErrPageLimit",
      "ErrCredentialCommit",
      "ErrInvalidSession",
      "ErrSessionClosed"
    ]
  },
  "oauth": {
    "structs": {
      "AuthorizationRequest": [
        "ClientID string",
        "RedirectURI string",
        "ResponseType ResponseType",
        "Scopes []helix.AuthorizationScope",
        "State string",
        "ForceVerify bool"
      ],
      "Authorization": [
        "URL string",
        "State string",
        "RedirectURI string",
        "ResponseType ResponseType"
      ],
      "AuthorizationResult": [
        "Code string",
        "AccessToken string",
        "Scopes []helix.AuthorizationScope",
        "State string",
        "TokenType string"
      ],
      "ClientCredentialsRequest": [
        "ClientID string",
        "ClientSecret string"
      ],
      "ExchangeCodeRequest": [
        "ClientID string",
        "ClientSecret string",
        "Code string",
        "RedirectURI string"
      ],
      "DeviceAuthorizationRequest": [
        "ClientID string",
        "Scopes []helix.AuthorizationScope"
      ],
      "DeviceAuthorization": [
        "DeviceCode string",
        "ExpiresIn time.Duration",
        "Interval time.Duration",
        "UserCode string",
        "VerificationURI string"
      ],
      "PollDeviceTokenRequest": [
        "ClientID string",
        "Scopes []helix.AuthorizationScope",
        "DeviceCode string",
        "ExpiresAt time.Time"
      ],
      "RefreshRequest": [
        "ClientID string",
        "ClientSecret string",
        "RefreshToken string"
      ],
      "TokenPair": [
        "AccessToken string",
        "RefreshToken string",
        "ExpiresIn time.Duration",
        "Scopes []helix.AuthorizationScope",
        "TokenType string"
      ],
      "ValidateRequest": [
        "AccessToken string"
      ],
      "Validation": [
        "ClientID string",
        "Login string",
        "Scopes []helix.AuthorizationScope",
        "UserID string",
        "ExpiresIn time.Duration"
      ],
      "RevokeRequest": [
        "ClientID string",
        "AccessToken string"
      ]
    },
    "enums": {
      "ResponseType": {
        "type": "string",
        "values": {
          "ResponseTypeCode": "code",
          "ResponseTypeToken": "token"
        }
      }
    },
    "functions": [
      "New(...Option) (*Client,error)",
      "WithHTTPClient(*http.Client) Option",
      "WithBaseURL(string) Option",
      "WithRandom(io.Reader) Option",
      "WithClock(helix.Clock) Option",
      "WithRefreshSkew(time.Duration) SourceOption",
      "WithValidationInterval(time.Duration) SessionOption",
      "WithValidationErrorHook(func(error)) SessionOption",
      "NewRefreshingTokenSource(*Client, TokenPair, CredentialHook, ...SourceOption) (*RefreshingTokenSource,error)",
      "NewManagedSession(context.Context, *RefreshingTokenSource, ...SessionOption) (*ManagedSession,error)"
    ],
    "methods": [
      "(*Client).AuthorizationURL(AuthorizationRequest) (Authorization,error)",
      "(*Client).ParseAuthorizationCallback(string, Authorization) (AuthorizationResult,error)",
      "(*Client).ClientCredentials(context.Context, ClientCredentialsRequest) (*TokenPair,error)",
      "(*Client).ExchangeCode(context.Context, ExchangeCodeRequest) (*TokenPair,error)",
      "(*Client).StartDeviceAuthorization(context.Context, DeviceAuthorizationRequest) (*DeviceAuthorization,error)",
      "(*Client).PollDeviceToken(context.Context, PollDeviceTokenRequest) (*TokenPair,error)",
      "(*Client).Refresh(context.Context, RefreshRequest) (*TokenPair,error)",
      "(*Client).Validate(context.Context, ValidateRequest) (*Validation,error)",
      "(*Client).Revoke(context.Context, RevokeRequest) error",
      "(*RefreshingTokenSource).Token(context.Context) (helix.CredentialSnapshot,error)",
      "(*RefreshingTokenSource).Refresh(context.Context, helix.CredentialSnapshot, helix.RefreshReason) (helix.CredentialSnapshot,error)",
      "(*RefreshingTokenSource).RetryCommit(context.Context) error",
      "(*RefreshingTokenSource).Close() error",
      "(*ManagedSession).Close() error"
    ],
    "errorTypes": [
      "OAuthError",
      "DeviceAuthorizationError"
    ],
    "lifecycle_precedence": [
      "Close atomically marks closed, cancels in-flight refresh/validation, discards later results, and all later Token/Refresh/RetryCommit return ErrSessionClosed",
      "Before Close, first successful compare-and-swap to terminal state wins between ErrCredentialCommit and ErrInvalidSession; later events cannot replace it",
      "Context cancellation affects only the calling waiter except constructor context cancellation, which returns no session"
    ]
  },
  "optionValidation": {
    "baseURL": "https required except http loopback test hosts",
    "httpClient": "nil invalid",
    "random": "nil invalid",
    "clock": "nil invalid",
    "refreshSkew": "0..15m inclusive",
    "validationInterval": "exactly 1h unless injected Clock is marked test clock",
    "duplicate": "last wins",
    "mutuallyExclusive": "none in oauth"
  },
  "scopes": {
